# Renode script for algo test harness
# Loads the test ELF that exercises crypto algorithms over UART.
#
# Usage:
#   renode renode/algo_test.resc

using sysbus

mach create

machine LoadPlatformDescription @platforms/boards/rp2040-pico.resc

sysbus LoadELF @${CURDIR}/../build-fw/tests/rp2040/algo_test.elf

showAnalyzer sysbus.uart0

start
