# Renode platform script for pico-yubikey
#
# Usage:
#   renode pico_yubikey.resc
#
# This loads the RP2040 Pico ELF, attaches UART to console,
# and boots the firmware.

using sysbus

mach create

machine LoadPlatformDescription @platforms/boards/rp2040-pico.resc

# Load the firmware ELF
sysbus LoadELF @${CURDIR}/../build-fw/src/pico_yubikey.elf

# Wire UART to console (monitor in terminal)
showAnalyzer sysbus.uart0

# Start simulation
start
